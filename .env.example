# ── 必填 ──────────────────────────────────────────────
# Bark device_key（Bark App 里点右上角复制），多个设备用英文逗号分隔
BARK_KEY=

# ── 可选 ──────────────────────────────────────────────
# Bark 服务地址，默认官方 https://api.day.app；自建改成 https://bark.your.com
BARK_SERVER=https://api.day.app

# 推送级别：active(默认) | timeSensitive(响铃并穿透专注模式) | critical | passive
BARK_LEVEL=timeSensitive

# 推送分组，Bark App 内按分组归档
BARK_GROUP=挪车提醒

# 推送图标（可选，填一个 https 图片地址）
BARK_ICON=

# 提示音（可选，如 alarm、bell，留空为默认）
BARK_SOUND=

# 是否存档：1 存档 / 0 不存档
BARK_ARCHIVE=1

# 车主电话：配置后页面会出现「拨打车主电话」按钮（按钮上不显示号码）
OWNER_PHONE=

# 展示用的车牌号，例如 京A·12345
PLATE=

# 页面标题
PAGE_TITLE=通知车主挪车

# 页面副标题
PAGE_TIP=车辆挡道？点一下按钮，车主会立即收到 Bark 推送

# 是否在拨号按钮下方以小字附一行脱敏号码：1 显示 / 0 完全不显示
SHOW_PHONE=0

# 页面有效时间（秒），到期后需要重新扫码访问才能交互；0 = 不限时
PAGE_TTL=300

# 同一 IP 两次推送的冷却秒数
COOLDOWN=60

# 同一 IP 每小时最多推送次数
MAX_PER_HOUR=5

# 推送时间所用时区偏移（中国填 8）
TIMEZONE_OFFSET=8
